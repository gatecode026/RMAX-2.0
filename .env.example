# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/rmax

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Public site URL (used for metadata, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Password given to the seeded demo account (facilities@example.org).
# The design does not show a password — choose your own.
SEED_DEMO_PASSWORD=

# ImageKit — product media storage/CDN. From ImageKit dashboard > Developer > API keys.
# IMAGEKIT_PRIVATE_KEY must never be exposed to the browser or committed with a real value.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ---------------------------------------------------------------------------
# Email notifications (Nodemailer). SERVER-ONLY: never prefix these with NEXT_PUBLIC_.
# Setup guide: docs/email-notifications.md
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
# true only for port 465 (implicit TLS); leave false for 587 (STARTTLS)
SMTP_SECURE=false
# Brevo needs STARTTLS on 587; only set false for a local mock SMTP server
# SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
# A sender address your SMTP provider has verified, e.g. "RMAX Solutions <alerts@your-domain.com>"
MAIL_FROM=
# Comma-separated admin inbox(es) for internal alerts
ADMIN_NOTIFICATION_EMAIL=
# Public site URL used in dashboard links, e.g. https://www.rmaxiot.in
APP_URL=http://localhost:3000
# Optional
DEFAULT_MANAGER_NOTIFICATION_EMAIL=
MAIL_REPLY_TO=
ENABLE_CUSTOMER_LEAD_EMAILS=false
ENABLE_CUSTOMER_ORDER_EMAILS=false
# Protects /api/cron/notifications (retries + recovery). Any long random string.
CRON_SECRET=
