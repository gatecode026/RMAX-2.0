# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/rmax

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Public site URL (used for metadata, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Password given to the seeded demo account (facilities@example.org).
# The design does not show a password — choose your own.
SEED_DEMO_PASSWORD=
